# Get the real values with the Neon CLI, from this folder:
#   neon env pull
# It writes .env.local for the branch in .neon. Never commit .env.local.

# Neon Postgres. Written by `neon env pull`.
# Pooled connection, used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by migrations (npm run db:migrate):
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=""
NEON_BRANCH_ID=""

# Seals calendar tokens in the database. Not from Neon: the team makes it
# once and shares it. 32 bytes in base64:
#   openssl rand -base64 32
# Changing it makes every stored token unreadable, so users would have to reconnect.
TOKEN_ENCRYPTION_KEY=""
