# Copy to .env.local for local work, or run `vercel env pull .env.local`. Never commit real values.

# Neon connection string (use the pooled one on Vercel).
DATABASE_URL=

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=
# The site's public address. Used in links inside emails.
AUTH_URL=http://localhost:3000

# Google Cloud OAuth web client (scopes: openid, email, profile).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra app registration (any organization plus personal accounts).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Resend. Without a key, development prints emails in the terminal instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Atlas <no-reply@your-verified-domain.com>"
